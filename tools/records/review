// この worktree も作業リポジトリの worktree なので、スクリプトがその中で記録の道具を呼ぶと、作業リポジトリの記録（gori のチェックアウトの .git/gori/repos/<名前>/）に書く。
// E2E は一時リポジトリの中で道具を呼び、GORI_ROOT で一時の gori のチェックアウトを指して、本物の記録に書かない。
// 作業者の身元や作業リポジトリを引き継がないよう環境を掃除し、時間の上限で process group ごと止める。出力はファイルに直接書く。
async function runE2E(script, judgeWt) {
  const dir = mkdtempSync(join(tmpdir(), 'gori-e2e-'));
  const logDir = join(judgeWt, '.gori-e2e');
  mkdirSync(logDir, { recursive: true });
  const logPath = join(logDir, `${e2eName(script)}.log`);
  try {
    if (insideRepo(dir)) throw new Error(`${dir}: 一時ディレクトリが作業リポジトリか gori のチェックアウト、またはその git の共通ディレクトリの中にある`);
    const add = spawnSync('git', ['-C', repo, 'worktree', 'add', '--detach', dir, sha], { encoding: 'utf8' });
    if (add.status !== 0) throw new Error(`E2E 用の worktree を作れない: ${add.stderr.trim()}`);
    const env = { ...process.env };
    for (const k of Object.keys(env)) if (k.startsWith('GIT_')) delete env[k];
    for (const k of ['CLAUDE_CODE_SESSION_ID', 'CLAUDE_SESSION_ID', 'CLAUDE_CODE_CHILD_SESSION', 'GORI_WORK_REPO', 'GORI_VERDICT_OUTBOX']) delete env[k];
    const fd = openSync(logPath, 'w');
    const t0 = Date.now();
    const res = await new Promise((done) => {
      const child = spawn(e2eShell.get(script)?.cmd ?? 'bash', [...(e2eShell.get(script)?.args ?? []), script], { cwd: dir, env, stdio: ['ignore', fd, fd], detached: true });
      let timedOut = false;
      const timer = setTimeout(() => {
        timedOut = true;
        try { process.kill(-child.pid, 'SIGKILL'); } catch { /* 既に終わっている */ }
      }, E2E_TIMEOUT_SEC * 1000);
      child.on('error', (e) => { clearTimeout(timer); done({ code: null, timedOut, error: e.message }); });
      child.on('close', (code, signal) => { clearTimeout(timer); done({ code: timedOut ? null : code ?? null, timedOut, signal }); });
    });
    closeSync(fd);
    const seconds = (Date.now() - t0) / 1000;
    const note = res.timedOut ? `\n[review] 時間の上限 ${E2E_TIMEOUT_SEC} 秒を超えたため止めた\n` : res.error ? `\n[review] 起動できない: ${res.error}\n` : res.signal ? `\n[review] シグナル ${res.signal} で終わった\n` : '';
    if (note) writeFileSync(logPath, readFileSync(logPath, 'utf8') + note);
    const copyDir = join(goriDir(repo, { write: true }), 'reviews');
    mkdirSync(copyDir, { recursive: true });
    copyFileSync(logPath, join(copyDir, `${task}-${sha.slice(0, 12)}-e2e-${e2eName(script)}-${Date.now()}.log`));
    return { script, code: res.code, timedOut: res.timedOut, seconds, logPath };
  } finally {
    spawnSync('git', ['-C', repo, 'worktree', 'remove', '--force', dir], { encoding: 'utf8' });
