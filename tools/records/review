#!/usr/bin/env node
import { parseArgs } from '../lib/args.mjs';
import { spawn, spawnSync } from 'node:child_process';
import { closeSync, copyFileSync, existsSync, mkdirSync, mkdtempSync, openSync, readdirSync, readFileSync, realpathSync, rmSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { basename, dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { RESULTS, TASK_ID, TASK_ID_FORM, acceptState, auditPath, git, gitCommonDir, goriDir, parseAudit, recordsGori, resolveRepoDir, storeVerdict, workBase, workerSessions } from '../lib/audit.mjs';
import { autoLimits, isAuto } from '../lib/auto.mjs';
import { modelFor } from '../lib/models.mjs';
import { reviewWeight } from '../lib/weight.mjs';
import { KEEP_MARK, staleNames } from '../lib/stale-names.mjs';
import { PoolError, acceptanceItems, goriCheckout, readItem, resolvePool } from '../lib/pool.mjs';
import { assistantText, choiceAnswers, humanText, projectsDir, readLines, sessionFiles, squash } from '../lib/transcripts.mjs';

const goriRoot = resolve(dirname(fileURLToPath(import.meta.url)), '..', '..');

const REVIEW_USAGE = '使い方: review --task <作業ID> [--sha <commit>] [--base <commit>] [--e2e <相対パス>]... [--model <名前>] [--repo <dir>] [--dry-run]';
const { flags, positional: extra } = parseArgs(process.argv.slice(2), { value: ['task', 'sha', 'base', 'model', 'repo'], repeat: ['e2e'], bool: ['dry-run'] }, REVIEW_USAGE);
flags.dryRun = flags['dry-run'] === true;
if (extra.length) {
  console.error(`引数 ${extra.join(' ')} を読めない（フラグの値なら、その前のフラグの綴りを確かめる）\n${REVIEW_USAGE}`);
  process.exit(2);
}

const die = (msg, code = 2) => {
  console.error(msg);
  process.exit(code);
};

if (!flags.task || !TASK_ID.test(flags.task)) die(`--task には ${TASK_ID_FORM} の作業 ID を渡す`);
const task = flags.task;
const repo = resolveRepoDir(flags.repo, task);
const sha = git(repo, ['rev-parse', '--verify', `${flags.sha ?? 'HEAD'}^{commit}`]);
if (!sha) die(`${repo}: ${flags.sha ?? 'HEAD'} を commit に解決できない`);
let audit;
try {
  audit = auditPath(repo, task);
} catch (e) {
  die(e.message, 2);
}
// 作業リポジトリの git の共通ディレクトリ。作業ツリーが課題の worktree なら、作業ツリーとは別の場所になる。レビュアーには書かせない。
const workCommon = gitCommonDir(repo);
if (!workCommon) die(`${repo}: git の共通ディレクトリを求められない`);
// 記録を置く gori のチェックアウト（記録は、その git の共通ディレクトリの下の gori/repos/<名前>/ にある）。レビュアーには書かせない。
let gori;
try {
  gori = recordsGori();
} catch (e) {
  die(e.message, 2);
}
const goriCommon = gitCommonDir(gori);
if (!goriCommon) die(`${gori}: git の共通ディレクトリを求められない`);
if (!existsSync(audit)) die(`${audit}: 判断の記録が無い。受け入れ基準を決められないのでレビューを依頼できない`);

// モデルはレビューの重さを決めた後に選ぶ（下の reviewWeight）。--model があればそれを使う。
let model = flags.model;

const rows = parseAudit(readFileSync(audit, 'utf8')).slice(1).map((r) => r.row);
const start = rows.find((r) => r.type === 'start');
if (!start) die(`${audit}: start 行が無い`);
const steps = rows.filter((r) => r.type === 'step');
// 行番号は記録のファイルの物理行（ヘッダが 1 行目）。fix の「行 N を訂正」「行 N を取り下げ」と同じ数え方である。
const numbered = parseAudit(readFileSync(audit, 'utf8')).slice(1);
const { accepts, fixesOf, withdrawals, corrections, active } = acceptState(numbered);
if (accepts.length === 0) die(`${audit}: accept 行が無い。受け入れ条件を log add --type accept で記録してからレビューを依頼する`);

// プールの一件から始めた作業は、受け入れ条件を写さず、accept 行に pool:<ID> とだけ書く（skills/decision-log）。
// レビューのたびに作業中のリポジトリのプールの一件を読み、その時点の「## 受け入れ条件」の各行を渡す。受け入れ条件の正本をプールの一か所にするためである。
// プールは gori のチェックアウトの git の共通ディレクトリの下にあり、本体のチェックアウトの名前で引く（tools/lib/pool.mjs）。課題の worktree から依頼しても同じ一件を読む。
const POOL_REF = /^pool:(\S+)$/;
function poolCriteria(id) {
  let item;
  try {
    const pool = resolvePool(goriCheckout(goriRoot), repo);
    item = readItem(pool.poolDir, id);
  } catch (e) {
    if (e instanceof PoolError) die(`accept 行 pool:${id} の受け入れ条件を読めない: ${e.message}`);
    throw e;
  }
  const items = acceptanceItems(item.body);
  if (items.length === 0) die(`${item.file}: 受け入れ条件（「## 受け入れ条件」の下の - で始まる行）が無い`);
  return items;
}
const acceptText = (r) => {
  const ref = POOL_REF.exec(r.row.what.trim());
  if (!ref) return `- 行 ${r.line}: ${r.row.what}`;
  return poolCriteria(ref[1]).map((c, i) => `- 行 ${r.line}（${ref[1]} の受け入れ条件 ${i + 1}）: ${c}`).join('\n');
};
// fix 行は、accept 行を訂正するか取り下げる（skills/decision-log）。取り下げた accept 行とその訂正は基準に入れず、取り下げた条件として理由とともに知らせる。
// 途中で方針が変わって要らなくなった条件で、レビュアーが不合格にしないためである。
if (active.length === 0) die(`${audit}: 受け入れ条件がすべて取り下げられている。今の受け入れ条件を log add --type accept で書き、承認を得てからレビューを依頼する`);

// 受け入れ条件は人間の承認を得てからレビューに出す（config/routing）。最後の受け入れ条件の行か、受け入れ条件を訂正するか取り下げる行より後に、
// 承認の行（log add --type approval。会話の中からは、引用が最後の人間の入力に含まれるときだけ書ける）が無ければ、レビュアーを起動しない。
// 受け入れ条件を直すか取り下げた後も承認をもらい直させるのは、直した条件を人間が見ていないままレビューに出さないためである。
const lastAcceptLine = Math.max(...accepts.map((r) => r.line), ...fixesOf('訂正').map((r) => r.line), ...withdrawals.map((r) => r.line));
// 無人の作業（GORI_AUTO）は、人間が一件を todo に上げたことを受け入れ条件の承認として扱う（docs/design.md の「自律起動」）。
// 受け入れ条件の行がどれも pool:<ID> で、訂正も取り下げも無く、その一件が今も todo のときに限り、承認の行が無くてもレビュアーを起動する。
// 担当が条件を足すか直した作業は、人間が見ていない条件を含むので、無人でも今までどおり止める。
function todoApproved() {
  if (!isAuto()) return null;
  if (fixesOf('訂正').length || withdrawals.length) return null;
  const ids = accepts.map((r) => POOL_REF.exec(r.row.what.trim())?.[1]);
  if (ids.some((id) => !id)) return null;
  for (const id of ids) {
    try {
      const pool = resolvePool(goriCheckout(goriRoot), repo);
      if (readItem(pool.poolDir, id).fields.status !== 'todo') return null;
    } catch (e) {
      if (e instanceof PoolError) return null;
      throw e;
    }
  }
  return ids;
}
const autoApproved = todoApproved();
if (!autoApproved && !numbered.some((r) => r.row.type === 'approval' && r.line > lastAcceptLine)) {
  die(`${audit}: 行 ${lastAcceptLine}（最後の受け入れ条件か、その訂正か取り下げ）より後に承認の行が無い。受け入れ条件を人間に示して承認を得てから、${join(goriRoot, 'tools', 'records', 'log')} add --task ${task} --type approval --what "<承認された案>" --quote "<承認の言葉>" を書いて依頼し直す（案には番号を振って示し、人間の返事から承認の言葉を切り出して渡す。複数の問いに答えた返事なら全文を渡す）`);
}

// レビュアーは、承認の行が受け入れ条件の案そのものを承認しているかを確かめる（agents/reviewer）。
// そのため、承認の引用に、その発言の直前に担当が示したメッセージ（問いと案）を添えて渡す。
// 直前のメッセージは、一つ前の人間の発言から後の担当の発言をつないだものである。
// 選択式の質問（AskUserQuestion）への回答で書いた承認では、回答も人間の入力として区切りに数える。
// 文章の発言の承認では回答で区切らない。回答の前に示した案の本文を、レビュアーに渡し続けるためである。
// 作業の通知（<task-notification>）は人間の発言に数えず、またいでつなぐ。
// 長いメッセージでも問いは末尾に来やすいので、末尾の BEFORE_MAX 文字を残す。
const BEFORE_MAX = 4000;
const NOTIFICATION = /^<task-notification>/;
function clip(t) {
  const s = squash(t);
  return [...s].length > BEFORE_MAX ? `…${[...s].slice(-BEFORE_MAX).join('')}` : s;
}
// 承認の行が指す人間の入力を探し、その直前のメッセージを返す。選択式の回答なら、各問いの文と選択肢と選んだ答えも返す。
function shownBefore(session, message, byChoice) {
  const file = session && session !== '-' ? sessionFiles(projectsDir()).get(session) : null;
  if (!file) return null;
  let said = [];
  for (const o of readLines(file)) {
    const a = assistantText(o);
    if (a !== null) said.push(a);
    const h = humanText(o);
    const answers = byChoice ? choiceAnswers(o) : null;
    if ((h === null || NOTIFICATION.test(h)) && !answers) continue;
    if (o.uuid === message) {
      const before = clip(said.join('\n'));
      if (!answers) return { before };
      const asked = o.toolUseResult?.questions ?? [];
      const choices = answers.map(({ question, answer }) => {
        const labels = (asked.find((q) => q.question === question)?.options ?? []).map((x) => x.label).filter(Boolean);
        return `問い「${squash(question)}」${labels.length ? ` 選択肢: ${labels.map((l) => `「${squash(l)}」`).join('、')}` : ''} 選んだ答え「${squash(answer)}」`;
      });
      return { before, choices };
    }
    said = [];
  }
  return null;
}
const approvals = numbered.filter((r) => r.row.type === 'approval' && r.line > lastAcceptLine);
const approvalSection = autoApproved && approvals.length === 0 ? `無人の作業である。承認の行は無い。人間がプールの一件（${autoApproved.join('、')}）を todo に上げたことを、その受け入れ条件の承認として扱う（docs/design.md の「自律起動」）。一件が todo であることと、受け入れ条件の行がその一件を指す行だけであることは、道具が確かめた。承認の行が無いことを理由に不合格にしない。` : approvals.map((r) => {
  const head = `- 行 ${r.line}: ${r.row.what}（${r.row.evidence}）`;
  const m = /^(発言|回答) (\S+) /.exec(r.row.evidence);
  if (!m) return `${head}\n  端末の人間が書いた承認で、直前のメッセージは無い。`;
  const found = shownBefore(r.row.session, m[2], m[1] === '回答');
  if (!found || (m[1] === '発言' && !found.before)) return `${head}\n  会話の記録を引けないので、直前のメッセージは確かめられない。`;
  const lines = [head];
  if (m[1] === '回答') {
    lines.push('  選択式の質問への回答で書いた承認である。問いの文は作業者が書いたもので、人間が選んだのは答えである。');
    if (found.choices) for (const c of found.choices) lines.push(`  - ${c}`);
  }
  lines.push(found.before ? `  この${m[1]}の直前に作業者が示したメッセージ:\n  > ${found.before}` : `  この${m[1]}の直前に、作業者のメッセージは無い。`);
  return lines.join('\n');
}).join('\n');

// 受入基準を読めなければ、レビュアーを起動する前に止まる。
const acceptSection = active.map(acceptText).join('\n');
const withdrawnSection = withdrawals.length ? `
## 取り下げた条件（基準ではない）
作業の途中で取り下げた受け入れ条件で、合否の基準にしない。
${withdrawals.map((w) => `${acceptText(accepts.find((a) => a.line === w.target))}\n  取り下げ（行 ${w.line}）: ${w.row.what}`).join('\n')}
作業の目的と受け入れ基準が食い違うときは、受け入れ基準を優先する。
` : '';

// レビューした commit がそのまま main に fast-forward で入るよう、main の先端を含まない commit はレビューしない。
// 比べるのはローカルの main、無ければ master である。どちらも無ければ確かめない。
const mainName = ['main', 'master'].find((b) => git(repo, ['rev-parse', '--verify', '-q', `refs/heads/${b}^{commit}`]));
if (mainName) {
  const tip = git(repo, ['rev-parse', '--verify', `refs/heads/${mainName}^{commit}`]);
  if (spawnSync('git', ['-C', repo, 'merge-base', '--is-ancestor', tip, sha]).status !== 0) {
    die(`commit ${sha} は ${mainName} の先端 ${tip} を含まない。レビューしても取り込むときに載せ直しが要り、レビューをやり直すことになるので、レビュアーを起動しない。${join(goriRoot, 'tools', 'repo', 'sync-main')} --task ${task} で ${mainName} の最新を取り込み、検証をやり直してから review --task ${task} --base ${mainName} で依頼し直す。レビューを受けた commit を手で書き換えない（criteria/done）`);
  }
}

// verdict record は、HEAD をレビューした結果を、作業ツリーが汚れていると dirty-tree で断る（tools/records/verdict）。
// レビュアーはその作業ツリーを直せないので、確かめ終えた後に断られて一回分が無駄になる。起動する前に同じ条件で止める。
if (sha === git(repo, ['rev-parse', 'HEAD'])) {
  const dirty = (git(repo, ['status', '--porcelain']) ?? '').split('\n').filter(Boolean);
  if (dirty.length) {
    const DIRTY_SHOWN = 10;
    die(`${repo}: 作業ツリーに未コミットの変更か未追跡のファイルがある（${dirty.length} 件）。レビュー結果を記録できないので、レビュアーを起動しない。commit するか片付けてから、review --task ${task} で依頼し直す:\n${dirty.slice(0, DIRTY_SHOWN).map((l) => `  ${l}`).join('\n')}${dirty.length > DIRTY_SHOWN ? `\n  ほか ${dirty.length - DIRTY_SHOWN} 件` : ''}`);
  }
}

// 範囲の起点: --base の指定、無ければ workBase（start 行の base=、start より前の最後の commit、親、空の木の順）。
function decideBase() {
  if (flags.base) {
    const b = git(repo, ['rev-parse', '--verify', `${flags.base}^{commit}`]);
    if (!b) die(`--base ${flags.base} を commit に解決できない`);
    return { base: b, how: '--base の指定' };
  }
  return workBase(repo, start, sha);
}
const { base, how } = decideBase();

// 範囲で消したか名前を変えたファイルの名前が残っていれば、レビュアーを起動しない（tools/lib/stale-names.mjs）。
// 旧い名前の消し残しは、レビューで不合格になり往復が一回増えるので、起動する前に見つける。
const stale = staleNames(repo, base, sha);
if (stale.length) {
  const SHOWN = 20;
  die(`commit ${sha} に、範囲（起点 ${base}）で消したか名前を変えたファイルの名前が ${stale.length} か所残っている。今の形に直して commit してから、review --task ${task} で依頼し直す。消した経緯として残す行は、行の中に印 ${KEEP_MARK} を書けば数えない。レビュアーを起動しない:\n${stale.slice(0, SHOWN).map((h) => `  ${h.file}:${h.line}: ${h.names.map((n) => `${n.name}（${n.from}）`).join('、')}: ${h.text.slice(0, 160)}`).join('\n')}${stale.length > SHOWN ? `\n  ほか ${stale.length - SHOWN} か所` : ''}`);
}

// --e2e のスクリプトは、レビューする commit にあるものだけを受け付ける。無ければレビュアーを起動しない。
const e2eScripts = flags.e2e ?? [];
// スクリプトの一行目の shebang の解釈器（bash、sh、zsh）と、その後ろの引数（#!/bin/bash -e の -e、#!/usr/bin/env -S zsh -f の -f）。
// shebang が無ければ bash。知らない解釈器なら null。env の後ろの - で始まる語（-S など）は env の引数なので、解釈器の名前の前では読み飛ばす。
const E2E_SHELLS = ['bash', 'sh', 'zsh'];
function e2eInterpreter(firstLine) {
  if (!firstLine.startsWith('#!')) return { cmd: 'bash', args: [] };
  const words = firstLine.slice(2).trim().split(/\s+/).filter(Boolean);
  let rest = words.slice(1);
  let name = basename(words[0] ?? '');
  if (name === 'env') {
    const i = rest.findIndex((w) => !w.startsWith('-'));
    name = i < 0 ? '' : basename(rest[i]);
    rest = i < 0 ? [] : rest.slice(i + 1);
  }
  return E2E_SHELLS.includes(name) ? { cmd: name, args: rest } : null;
}
const e2eShell = new Map();
for (const sc of e2eScripts) {
  if (!sc || sc.startsWith('/') || sc.split('/').includes('..')) die(`--e2e ${sc}: リポジトリからの相対パスで渡す`);
  const ty = spawnSync('git', ['-C', repo, 'cat-file', '-t', `${sha}:${sc}`], { encoding: 'utf8' });
  if (ty.status !== 0 || ty.stdout.trim() !== 'blob') die(`--e2e ${sc}: commit ${sha} にこのスクリプトが無い。レビュアーを起動しない`);
  const firstLine = (spawnSync('git', ['-C', repo, 'show', `${sha}:${sc}`], { encoding: 'utf8' }).stdout ?? '').split('\n')[0].replace(/\r$/, '');
  const shell = e2eInterpreter(firstLine);
  if (!shell) die(`--e2e ${sc}: shebang「${firstLine}」の解釈器は知らない（bash、sh、zsh だけ）。レビュアーを起動しない`);
  e2eShell.set(sc, shell);
}
// レビューの重さ。範囲の差分のファイルから道具が決め、軽ければ reviewer-light のモデルで、確かめる範囲を絞って依頼する。
const changed = (git(repo, ['diff', '--name-only', '--no-renames', base, sha]) ?? '').split('\n').filter(Boolean);
const { weight, reason: weightReason } = reviewWeight(changed, { e2e: e2eScripts.length > 0 });
// 担当の自己点検の行（log add --type check）がそろっていなければ、レビュアーを起動しない。
// 点検せずに出して不合格になる往復を防ぐためである。数えるのは、レビューする commit の SHA を result に持つ行だけで、点検の後に commit したら点検し直す。
// 要る指し: 有効な受け入れ基準のそれぞれ（accept 行は「行 N」、pool:<ID> の行は条件 k ごとに「行 N#k」）、最後の承認の行（「承認」。無人の承認では要らない）、範囲の差分が .md を変えるときの「文書」。
{
  const needed = [];
  for (const a of active) {
    const ref = POOL_REF.exec(a.row.what.trim());
    if (!ref) needed.push(`行 ${a.line}`);
    else poolCriteria(ref[1]).forEach((_, i) => needed.push(`行 ${a.line}#${i + 1}`));
  }
  if (!autoApproved) needed.push('承認');
  if (changed.some((f) => /\.md$/i.test(f))) needed.push('文書');
  const done = new Set(numbered.filter((r) => r.row.type === 'check' && r.row.result === sha && r.row.evidence && r.row.evidence !== '-').map((r) => r.row.what));
  const missing = needed.filter((c) => !done.has(c));
  if (missing.length) {
    const logTool = join(goriRoot, 'tools', 'records', 'log');
    die(`${audit}: commit ${sha} の自己点検の行（check 行）が欠けている。レビュアーを起動しない。欠けた指し:\n${missing.map((c) => `  - ${c}`).join('\n')}\n実物で点検してから、欠けた指しごとに書く（点検の後に commit したら、点検し直す）:\n  ${logTool} add --task ${task} --type check --criterion '<指し>' --evidence '<コマンドと出力の要点>'\n指し: 「行 N」「行 N#k」は受け入れ基準（N は accept 行、k は pool:<ID> の条件の番号）、「承認」は最後の承認の行が案そのものを承認していること、「文書」は差分が .md に書いた値、件数、振る舞いを実物と照らしたこと`);
  }
}
if (!model) {
  try {
