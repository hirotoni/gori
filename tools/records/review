  } catch (e) {
    die(e.message);
  }
}
const e2eName = (sc) => sc.replace(/\//g, '__');
const E2E_TIMEOUT_SEC = Number(process.env.GORI_E2E_TIMEOUT_SEC || 1800);

// 同じ作業のいちばん新しいレビュー結果が不合格か確認できずなら、その指摘を依頼文に渡す。直したか、足りなかった材料が今回あるかを先に確かめさせ、同じ不足で回数を重ねないためである。
// 渡すのはレビュアー（か端末の人間）が記録したレビュー結果で、作業者の主張ではない。どの commit のものでも読む（載せ直しや修正で commit は変わる）。
// 新しさはファイル名の先頭の時刻（verdictFileName）で決める。読めないファイルは飛ばす。合否の決め方は verdictState のままで、ここは依頼文の材料にするだけである。
function taskVerdicts() {
