    else if (m[1] !== judgeSession) why.push(`judge が ${v.judge}（レビュアーの init の session_id は ${judgeSession}）`);
    if (m && workers.has(m[1])) why.push(`judge ${v.judge} は判断の記録に作業者として現れる（self-judgment）`);
