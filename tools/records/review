let vetted = null;
try {
  for (const d of [wt, outbox]) if (insideRepo(d)) throw new Error(`${d}: 一時ディレクトリが作業リポジトリか gori のチェックアウト、またはその git の共通ディレクトリの中にある。TMPDIR をその外にして実行し直す`);
  const add = spawnSync('git', ['-C', repo, 'worktree', 'add', '--detach', wt, sha], { encoding: 'utf8' });
  if (add.status !== 0) throw new Error(`worktree を作れない: ${add.stderr.trim()}`);
  const e2eResults = [];
  for (const sc of e2eScripts) e2eResults.push(await runE2E(sc, wt));
  const prompt = makePrompt(e2eSectionOf(e2eResults));
  // GORI_REVIEWING は、レビュアーのセッションの終わりに抽出を起動しないための印である（レビュー結果の資格には使わない）。
  const env = { ...process.env, GORI_WORK_REPO: repo, GORI_VERDICT_OUTBOX: outbox, GORI_REVIEWING: '1' };
  // レビュアーは自分のセッションの ID を自分で得る。親の ID が漏れて作業者を名乗らないよう消す。
  for (const k of ['CLAUDE_CODE_SESSION_ID', 'CLAUDE_SESSION_ID', 'CLAUDE_CODE_CHILD_SESSION']) delete env[k];
  const r = spawnSync(bin, buildArgs(wt, outbox), { cwd: wt, input: prompt, encoding: 'utf8', env, maxBuffer: 256 * 1024 * 1024 });
  // レビュアーの出力（セッションの全記録）はファイルに写さない。差分やファイルの中身を含む会話の記録で、
  // Claude Code が自分の記録として既定の期間だけ残すので、gori の下に期限なく残さない（criteria/user-environment）。
  // 端末には、後から Claude Code の記録を引くためのセッション ID と、失敗を調べるための最後の結果の文だけを出す。
  judgeSession = initSession(r.stdout);
  judgeResult = resultText(r.stdout);
  console.log(`レビュアーのセッション: ${judgeSession ?? '（読めない）'}`);
  if (r.error) console.error(`レビュアーを起動できない: ${r.error.message}`);
  else if (r.status !== 0) console.error(`レビュアーが終了コード ${r.status} で終わった: ${(r.stderr ?? '').trim().slice(0, 500)}`);
  vetted = vetOutbox(outbox, judgeSession);
} catch (e) {
  failure = e.message;
} finally {
  spawnSync('git', ['-C', repo, 'worktree', 'remove', '--force', wt], { encoding: 'utf8' });
  rmSync(wt, { recursive: true, force: true });
  rmSync(outbox, { recursive: true, force: true });
  spawnSync('git', ['-C', repo, 'worktree', 'prune'], { encoding: 'utf8' });
}

if (failure) die(failure);
if (vetted.bad.length) {
  for (const b of vetted.bad) console.error(`取り込まないレビュー結果: ${b}`);
  console.log(`未レビュー: レビュアーの受け取り口に、確かめられないレビュー結果があった。どれも取り込まない`);
  if (judgeResult) console.log(`レビュアーの最後の文: ${judgeResult}`);
  process.exit(3);
}
if (vetted.ok.length === 0) {
  console.log(`未レビュー: レビュアーのセッションが ${sha.slice(0, 12)} のレビュー結果を記録しなかった`);
  if (judgeResult) console.log(`レビュアーの最後の文: ${judgeResult}`);
  process.exit(3);
}
for (const v of vetted.ok) {
  const res = storeVerdict(repo, audit, v);
  console.log(`レビュー結果を取り込んだ: ${res.file}`);
  if (res.violations.length) {
    for (const x of res.violations) console.error(`${audit}:${x.line}: ${x.rule}: ${x.message}`);
    die('レビュー結果は取り込んだが、判断の記録への追記が検査に落ちた', 2);
  }
}
const c = spawnSync(process.execPath, [verdictTool, 'check', '--task', task, '--sha', sha], { cwd: repo, encoding: 'utf8', env: { ...process.env, GORI_WORK_REPO: repo } });
process.stdout.write(c.stdout);
process.stderr.write(c.stderr);
process.exit(c.status ?? 2);
