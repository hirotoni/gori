    if (v.sha !== sha) why.push(`sha が ${v.sha}（依頼は ${sha}）`);
    const m = /^session:(.+)$/.exec(v.judge ?? '');
    if (!m) why.push(`judge が ${v.judge}（session:<ID> でない）`);
