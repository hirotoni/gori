{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/tools/hooks/session-start\"" }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/tools/hooks/session-end\"" }]
      }
    ]
  }
}
