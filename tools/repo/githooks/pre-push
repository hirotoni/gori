#!/bin/sh
# push する中身を tools/repo/check-public で必ず確かめ、当たれば push を止める（docs/design.md の「公開と上流」）。
# git は標準入力に「<ローカルの ref> <ローカルの SHA> <送る先の ref> <送る先の SHA>」を一行ずつ渡す。
# 見るのは、送る先端の commit で追跡しているファイルと、送る先にまだ無い commit のメッセージと、その commit が足した行である。
# ref を消す push（ローカルの SHA が 0 だけ）は、何も送らないので確かめない。
remote="$1"
check="$(git rev-parse --show-toplevel)/tools/repo/check-public"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    node "$check" --commit "$local_sha" -- "$local_sha" --not "--remotes=$remote" || status=1
  else
    node "$check" --commit "$local_sha" -- "$remote_sha..$local_sha" || status=1
  fi
done
exit $status
