#!/usr/bin/env node
// 公開する中身に、手元の情報が入っていないかを確かめる（docs/design.md の「公開と上流」）。push の前のフック（tools/repo/githooks/pre-push）が必ず呼ぶ。
// 見るのは、--commit の commit で追跡しているファイルの中身と、-- の後ろの git rev-list の引数で選んだ commit のメッセージと、その commit が足した行である。
// 足した行も見るのは、ある commit で足して次の commit で消した中身も、push すれば公開の履歴に載るためである。
// 探すもの: ホームの下の絶対パス（/Users/<名前>、/home/<名前>）、メールアドレス、秘密らしい文字列（tools/lib/secrets.mjs の検査）、手元だけの禁止語。
// メールアドレスは、架空のドメイン（example.com、example.org、example.net、example.invalid）と noreply のアドレスを除く。
// 禁止語は、カレントのリポジトリの git の共通ディレクトリの下の gori/public-deny.txt に一行に一語で置く（# で始まる行と空行は読まない）。一覧そのものが手元の情報なので commit しない。
// 秘密の検査だけは、行に印 check-public: allow-secret があれば外す（秘密の検査の定義と、テストの偽の値のため）。パス、メールアドレス、禁止語は外せない。
// 当たった箇所は、場所と種類だけを出し、当たった文字列は出さない（秘密らしい文字列をログに写さないため）。
// 使い方: check-public [--commit <rev>] [-- <git rev-list の引数>...]
// 終了コード: 0 当たり無し、1 当たりがある、2 使い方の誤りか git の失敗
import { spawnSync } from 'node:child_process';
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import { secretKinds } from '../lib/secrets.mjs';

const USAGE = '使い方: check-public [--commit <rev>] [-- <git rev-list の引数>...]';
const die = (msg) => {
  console.error(`check-public: ${msg}`);
  process.exit(2);
};

// 道具の失敗を当たり（1）と取り違えないよう、思わぬ例外も 2 で終える。
process.on('uncaughtException', (e) => die(e.message));

const argv = process.argv.slice(2);
let commit = 'HEAD';
let revList = null;
for (let i = 0; i < argv.length; i++) {
  if (argv[i] === '--commit' && argv[i + 1]) commit = argv[++i];
  else if (argv[i] === '--') {
    revList = argv.slice(i + 1);
    break;
  } else die(USAGE);
}

const env = Object.fromEntries(Object.entries(process.env).filter(([k]) => !k.startsWith('GIT_') || k === 'GIT_DIR'));
const git = (args, input) => {
  const r = spawnSync('git', args, { env, input, maxBuffer: 1 << 30 });
  if (r.status !== 0) die(`git ${args.join(' ')} に失敗した: ${r.stderr.toString().trim()}`);
  return r.stdout;
};

const common = git(['rev-parse', '--path-format=absolute', '--git-common-dir']).toString().trim();
const denyFile = join(common, 'gori', 'public-deny.txt');
const deny = existsSync(denyFile)
  ? readFileSync(denyFile, 'utf8').split('\n').map((l) => l.trim()).filter((l) => l && !l.startsWith('#')).map((l) => l.toLowerCase())
  : [];

const HOME_PATH = /(?:^|[^A-Za-z0-9_.-])\/(?:Users|home)\/[A-Za-z0-9._-]+/;
const EMAIL = /[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+/g;
const ALLOWED_EMAIL = (addr) => /noreply/i.test(addr) || /@example\.(com|org|net|invalid)$/i.test(addr);

// 一行ずつ、当たった種類を返す。
function kindsOf(line) {
  const kinds = [];
  if (HOME_PATH.test(line)) kinds.push('ホームの下の絶対パス');
  if ((line.match(EMAIL) ?? []).some((a) => !ALLOWED_EMAIL(a))) kinds.push('メールアドレス');
  // 秘密らしい文字列の検査そのものや、検査のための偽の値の行は、行の中の印 check-public: allow-secret で秘密の検査だけを外す。
  if (!line.includes('check-public: allow-secret')) kinds.push(...secretKinds(line));
  const lower = line.toLowerCase();
  if (deny.some((w) => lower.includes(w))) kinds.push('禁止語');
  return kinds;
}

const hits = [];
const scan = (where, text) => {
  text.split('\n').forEach((line, i) => {
    for (const k of kindsOf(line)) hits.push(`${where}:${i + 1}: ${k}`);
  });
};

// 追跡しているファイル。中身は git cat-file --batch でまとめて読み、NUL を含むもの（バイナリ）は読まない。
const sha = git(['rev-parse', '--verify', `${commit}^{commit}`]).toString().trim();
const entries = git(['ls-tree', '-r', '-z', sha]).toString().split('\0').filter(Boolean).map((e) => {
  const [meta, path] = e.split('\t');
  const [, type, id] = meta.split(' ');
  return { type, id, path };
}).filter((e) => e.type === 'blob');
if (entries.length) {
  const out = git(['cat-file', '--batch'], entries.map((e) => e.id).join('\n') + '\n');
  let pos = 0;
  for (const e of entries) {
    const nl = out.indexOf(0x0a, pos);
    const size = Number(out.subarray(pos, nl).toString().split(' ')[2]);
    const body = out.subarray(nl + 1, nl + 1 + size);
    pos = nl + 1 + size + 1;
    if (body.includes(0)) continue;
    scan(e.path, body.toString('utf8'));
  }
}

// commit のメッセージと、commit が足した行。
// 足した行は、親との差分（root commit は空の木との差分）の + の行で、場所は新しい側のファイルの行番号で示す。
// merge commit の差分は見ない。merge される側の commit がそれぞれ範囲に入り、そこで見るためである。バイナリの差分は + の行を持たない。
const scanAdded = (id) => {
  const diff = git(['diff-tree', '-p', '-r', '-U0', '--root', '--no-color', '--no-ext-diff', '--no-renames', '--no-commit-id', id]).toString();
  // ファイルごとの見出し（diff --git から最初の @@ まで）の +++ だけをパスと読む。中身の行の「++ 」で始まる追加と取り違えないためである。
  let path = null;
  let n = 0;
  let header = false;
  for (const line of diff.split('\n')) {
    if (line.startsWith('diff --git ')) {
      header = true;
      path = null;
      continue;
    }
    if (header && line.startsWith('+++ ')) {
      const p = line.slice(4).replace(/^"(.*)"$/, '$1');
      path = p === '/dev/null' ? null : p.replace(/^b\//, '');
      continue;
    }
    const hunk = /^@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@/.exec(line);
    if (hunk) {
      header = false;
      n = Number(hunk[1]);
      continue;
    }
    if (!header && path && line.startsWith('+')) {
      for (const k of kindsOf(line.slice(1))) hits.push(`commit ${id.slice(0, 12)} の ${path}:${n}: ${k}`);
      n++;
    }
  }
};
if (revList) {
  const ids = git(['rev-list', ...revList]).toString().split('\n').filter(Boolean);
  for (const id of ids) {
    scan(`commit ${id.slice(0, 12)} のメッセージ`, git(['log', '-1', '--format=%B', id]).toString());
    scanAdded(id);
  }
}

for (const h of hits) console.log(h);
if (hits.length) {
  console.error(`check-public: 公開してはいけないものが ${hits.length} か所ある。直してから push する（禁止語の一覧: ${denyFile}）`);
  process.exit(1);
}
console.log(`check-public: 当たり無し（${sha.slice(0, 12)}、ファイル ${entries.length} 件${revList ? '、範囲の commit のメッセージと足した行も確かめた' : ''}）`);
